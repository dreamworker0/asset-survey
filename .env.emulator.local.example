# 에뮬레이터 모드(vite --mode emulator)용 가짜 Firebase 값 — 실제 프로젝트 값이 아니다.
# 처음 한 번: 이 파일을 .env.emulator.local 로 복사한다(그 파일은 git에서 빠진다).
# 에뮬레이터에만 연결되므로 운영 Firebase에 닿지 않는다.
VITE_FIREBASE_API_KEY=demo-api-key
VITE_FIREBASE_AUTH_DOMAIN=demo-asset-survey.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=demo-asset-survey
VITE_FIREBASE_STORAGE_BUCKET=demo-asset-survey.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=1
VITE_FIREBASE_APP_ID=1:1:web:1
VITE_USE_EMULATOR=true
