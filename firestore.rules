rules_version='2'

service cloud.firestore {
  match /databases/{database}/documents {

    // === 헬퍼 함수 (Custom Claims 기반 — get() 호출 없이 빠른 검증) ===
    function isSignedIn() {
      return request.auth != null;
    }

    function isSuperAdmin() {
      return isSignedIn()
        && request.auth.token.role == 'superAdmin';
    }

    function isOrgMember(orgId) {
      return isSignedIn()
        && request.auth.token.orgId == orgId;
    }

    // 행위자 스탬프(lastEditedByUid) 검증 — 접속기록의 '계정' 항목 (고시 제16조).
    //
    // 트리거는 호출자를 알 수 없으므로 클라이언트가 자기 uid를 심고, Rules가 그 값이
    // 인증 토큰과 일치함을 보장한다. 그래서 **타인 명의로는 위조할 수 없다**.
    //
    // "변경될 때만" 검사하는 이유: 모든 update에 스탬프를 요구하면 스탬프를 심지 않는
    // 경로가 하나라도 남아 있을 때 그 기능이 통째로 permission-denied가 된다
    // (차량운행일지에서 실제로 겪은 함정이다). 생략은 여전히 가능하지만 그 경우 감사 로그에
    // actorSource:'unknown'으로 남아 **누락이 조용히 성공으로 위장되지 않는다**.
    function actorStampValid() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(['lastEditedByUid'])
             || request.resource.data.lastEditedByUid == request.auth.uid;
    }

    function isOrgAdmin(orgId) {
      return isOrgMember(orgId)
        && request.auth.token.role == 'admin';
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function userOrgId() {
      return request.auth.token.orgId;
    }

    function belongsToMyOrg() {
      return isSignedIn() && resource.data.organizationId == userOrgId();
    }

    function newBelongsToMyOrg() {
      return isSignedIn() && request.resource.data.organizationId == userOrgId();
    }

    // === 사용자 ===
    match /users/{userId} {
      // 자기 자신 + superAdmin + 같은 기관 멤버만 읽기 가능.
      // organizationId != null 조건이 없으면 "null == null"이 참이 되어, 기관 미소속
      // (탈퇴·이동 대기, orgId 클레임 null) 계정끼리 서로의 문서(이메일·이름·연락처)를
      // 읽을 수 있다 — 미소속 사용자는 어떤 기관의 멤버도 아니므로 본인 외 열람 불가.
      allow read: if isOwner(userId)
                  || isSuperAdmin()
                  || (isSignedIn()
                      && resource != null
                      && resource.data.organizationId != null
                      && resource.data.organizationId == userOrgId());
      // consent(이용약관 동의 기록)는 joinOrganization(Admin SDK)만 기록한다.
      // 클라이언트가 심으면 동의하지 않은 계정에 동의 기록이 생겨 입증 자료가 무의미해진다.
      allow create: if isOwner(userId)
                    && request.auth.token.firebase.sign_in_provider != 'anonymous'
                    && request.resource.data.keys().hasAll(['email'])
                    && request.resource.data.email is string
                    && !request.resource.data.keys().hasAny(['role', 'organizationId', 'consent']);
      // consent 필드는 본인·기관관리자·superAdmin 누구도 값을 바꿀 수 없다.
      // (문서 자체의 삭제는 아래 allow delete가 superAdmin에게 허용하며,
      //  Admin SDK 서버 경로는 Rules를 우회하므로 필드 단위 보호로 한정된다.)
      allow update: if !request.resource.data.diff(resource.data).affectedKeys().hasAny(['consent'])
                    && actorStampValid()
                    && (
                       (isOwner(userId)
                        && (
                            // teamId(2026-11-22): 공간 담당 권한이 팀으로도 오므로 본인이 팀을 고르지 못하게 한다
                            !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'organizationId', 'status', 'disabledAt', 'teamId'])
                            || (
                                // 사용자가 스스로 기관을 탈퇴/초기화하여 '다른 기관으로 가입'하는 행위 허용
                                request.resource.data.organizationId == null
                                && request.resource.data.role == 'employee'
                                && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['status', 'disabledAt'])
                            )
                        ))
                    || isSuperAdmin()
                    // orgAdmin은 소속 기관 사용자만 수정 가능하되, superAdmin 역할 부여 불가.
                    // organizationId는 불변으로 강제한다 — admin이 자기/타인 문서의 org를 바꿔
                    // 타 기관 admin 클레임을 획득하는 교차 테넌트 권한상승을 차단(2026-07-04 감사 N1).
                    // 대상이 superAdmin인 문서는 건드리지 못한다 — addSuperAdmin은 organizationId를
                    // 지우지 않으므로 기관 소속 superAdmin이 생기고, 이 조건이 없으면 그 기관의
                    // 관리자가 운영자를 employee로 강등하거나 status를 disabled로 바꿀 수 있었다
                    // (2026-10-17 규칙 감사 #13). 직원 관리 화면은 superAdmin을 목록에서 빼므로
                    // 정상 경로는 영향이 없다(useEmployeeManager).
                    // status·disabledAt(활성/비활성)은 관리자도 직접 못 바꾼다 — Auth 계정 차단과 한 몸이라
                    // 콜러블(disableUser·enableUser)만 바꾼다. 문서만 'active'로 고치면 목록은 활성인데
                    // 로그인은 auth/user-disabled로 막히는 반쪽 복구가 된다(2026-11-18 기관 문의).
                    || (isOrgAdmin(resource.data.organizationId)
                        && resource.data.get('role', 'employee') != 'superAdmin'
                        && request.resource.data.role != 'superAdmin'
                        && request.resource.data.organizationId == resource.data.organizationId
                        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['status', 'disabledAt']))
                    );
      allow delete: if isSuperAdmin();

      // 비밀 사용자 데이터 (Google OAuth access/refresh 토큰 등) — Cloud Functions(Admin SDK) 전용.
      // 과거 users 문서에 googleOauth를 저장해 같은 기관 멤버 누구나 리프레시 토큰을 읽어
      // 계정을 임퍼소네이션할 수 있었음 (2026-07-10 감사 #4).
      match /private/{docId} {
        allow read, write: if false;
      }
    }

    // === 기관 ===
    match /organizations/{orgId} {
      // 소속 멤버, 신청자 본인, superAdmin만 읽기 가능 (초대 코드 검증은 Cloud Function에서 처리)
      allow read: if isSuperAdmin()
                  || isOrgMember(orgId)
                  || (isSignedIn() && resource.data.applicantUid == request.auth.uid);
      // 기관 생성은 서버(submitOrgApplication, Admin SDK) 또는 superAdmin 전용.
      // 과거 클라이언트 create는 status:'approved'·inviteCode를 임의 지정해 AI 검증·
      // superAdmin 승인 절차를 통째로 우회할 수 있었음 (2026-07-10 감사 #2).
      // create에서도 consent를 심을 수 없다 — 막지 않으면 superAdmin이 클라이언트에서
      // 임의 동의 기록을 가진 기관을 만들 수 있어 update 차단이 무의미해진다.
      allow create: if isSuperAdmin() && !('consent' in request.resource.data);
      // 동의 기록(consent)은 위탁 계약 성립의 입증 자료이므로 어떤 클라이언트도 변경·삭제할 수 없다.
      // submitOrgApplication(Admin SDK)만 기록하며, 규칙을 우회하는 서버 경로로만 갱신한다.
      //
      // 기관관리자는 **서버가 소유한 필드**도 건드릴 수 없다 (2026-09-02 보안 점검).
      // 종전에는 consent만 막아, 기관관리자가 자기 기관 문서의 나머지 필드를 전부 쓸 수 있었다:
      //   - inviteCode: 다른 기관의 초대 코드를 자기 기관에 복사하면 joinOrganization이
      //     `where inviteCode == code limit(1)`로 찍는 기관이 둘이 되어 신규 직원을 가로챌 수 있다.
      //     재발급은 regenerateInviteCode 콜러블(서버 난수 + 중복 검사)로만 한다.
      //   - uniqueNumberImagePath·aiVerifyDetail: 값을 바꿀 때마다 autoVerifyDocument가 재발동해
      //     Gemini 호출과 승인 이메일·알림톡 발송이 상한 없이 반복된다.
      //   - status·approvedAt·rejectedAt·deletedAt: 승인 상태는 superAdmin과 서버 배치만 바꾼다.
      //   - applicant*·uniqueNumber: 신청 시 확정된 신원 정보. 알림톡·이메일 수신처가 여기서 나온다.
      // superAdmin(승인·반려·복구)과 신청자 경로(pending 상태의 본인 신청)는 종전과 같다.
      allow update: if !request.resource.data.diff(resource.data).affectedKeys().hasAny(['consent'])
                    // 조사 방식은 정해진 값만 (기획서 F02). 화면이 고르게 하지만 우회 쓰기를 여기서 끊는다
                    && (!('surveyMode' in request.resource.data)
                        || request.resource.data.surveyMode in ['delegated', 'solo'])
                    // 엑셀 가져오기의 열·위치 연결 (기획서 F04·F06) — 맵이어야 한다
                    && (!('importColumnMap' in request.resource.data) || request.resource.data.importColumnMap is map)
                    && (!('locationSpaceMap' in request.resource.data) || request.resource.data.locationSpaceMap is map)
                    // 라벨 기본 규격 (기획서 F09)
                    && (!('labelSize' in request.resource.data)
                        || request.resource.data.labelSize in ['small', 'medium', 'large', 'custom'])
                    && (!('labelCustom' in request.resource.data) || request.resource.data.labelCustom is map)
                    // 관리 책임자 정·부(2026-11-22) — 기록용 글자, 라벨 표시 여부
                    && (!('managerPrimary' in request.resource.data) || (request.resource.data.managerPrimary is string && request.resource.data.managerPrimary.size() <= 50))
                    && (!('managerSecondary' in request.resource.data) || (request.resource.data.managerSecondary is string && request.resource.data.managerSecondary.size() <= 50))
                    && (!('labelShowManagers' in request.resource.data) || request.resource.data.labelShowManagers is bool)
                    && (
                      isSuperAdmin()
                      || (isOrgAdmin(orgId) && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
                            'inviteCode', 'status', 'approvedAt', 'rejectedAt', 'deletedAt', 'deletedBy', 'createdAt',
                            'aiVerified', 'aiVerifyDetail', 'ocrPrescreen',
                            'uniqueNumber', 'uniqueNumberImagePath', 'uniqueNumberImageUrl',
                            'applicantUid', 'applicantEmail', 'applicantName', 'applicantPhone'
                          ]))
                      // 신청자 본인 수정 분기(status:'pending' + applicantUid == uid)는 2026-11-24 뺐다 —
                      // 신청은 로그인 없이 submitOrgApplication(Admin SDK)이 만들고 applicantUid를
                      // "anonymous-app"으로 남겨, 어떤 계정과도 맞지 않는 죽은 분기였다. 남겨 두면
                      // applicantUid를 실제 uid로 쓰는 경로가 생기는 순간 승인 전 기관 문서가 열린다.
                    );
      allow delete: if isSuperAdmin();

      // 직원 사전 등록 (서브컬렉션)
      match /preRegistered/{preRegId} {
        allow read: if isOrgMember(orgId) || isSuperAdmin();
        allow write: if isOrgAdmin(orgId) || isSuperAdmin();
      }

      // 집계 통계 (서브컬렉션 — Cloud Functions에서 생성/갱신)
      match /stats/{statId} {
        allow read: if isOrgMember(orgId) || isSuperAdmin();
        allow write: if false; // Cloud Functions(admin SDK)에서만 쓰기
      }
    }

    // === 공간 (기획서 F03) ===
    // 재물이 놓인 곳과 그 공간 담당자. 공간 이름은 민감하지 않고, 조사 중 "다른 공간에서 발견"을
    // 보여 주려면 직원도 기관의 공간 목록을 알아야 하므로 **읽기는 같은 기관 구성원 전부**다.
    // "공간 담당자는 자기 공간만" 경계는 조사 대상·스캔 컬렉션(4단계)에서 건다.
    //
    // 쓰기는 기관 관리자만. 지우지 않는다 — 재물·조사 기록이 공간을 가리키게 되므로 숨김(archived)만 쓴다.
    // 담당자(managerUids)가 정말 같은 기관 사람인지는 Rules에서 확인하지 않는다(uid마다 get()이 든다).
    // 다른 기관 uid를 넣어도 그 사람은 이 문서를 읽을 수 없으므로 권한이 새지 않는다 — 화면이 구성원만 고르게 한다.
    function spaceDataValid(d) {
      return d.keys().hasOnly(['organizationId', 'name', 'order', 'managerUids', 'teamIds', 'archived',
                               'buildingId', 'floor', 'lastEditedByUid', 'createdAt', 'updatedAt'])
             // 담당 팀(2026-11-22) — 예전 문서에는 없다
             && (!('teamIds' in d) || (d.teamIds is list && d.teamIds.size() <= 10))
             && d.organizationId is string
             && d.name is string && d.name.size() > 0 && d.name.size() <= 50
             // 건물·층은 비워 둘 수 있다(건물을 등록하지 않은 기관). 건물이 같은 기관 것인지는 확인하지 않는다 —
             // 다른 기관 건물 ID를 넣어도 그 문서를 읽을 수 없어 화면에서 '건물 미지정'으로 보일 뿐이다.
             && (!('buildingId' in d) || nullableString(d.buildingId, 100))
             && (!('floor' in d) || nullableString(d.floor, 10))
             && d.order is int && d.order >= 0
             && d.managerUids is list && d.managerUids.size() <= 20
             && d.archived is bool
             && d.updatedAt == request.time;
    }

    match /spaces/{spaceId} {
      allow read: if isSuperAdmin() || isOrgMember(resource.data.organizationId);
      allow create: if (isSuperAdmin() || isOrgAdmin(request.resource.data.organizationId))
                    && spaceDataValid(request.resource.data)
                    && request.resource.data.createdAt == request.time
                    && request.resource.data.lastEditedByUid == request.auth.uid;
      allow update: if (isSuperAdmin() || isOrgAdmin(resource.data.organizationId))
                    && spaceDataValid(request.resource.data)
                    && request.resource.data.organizationId == resource.data.organizationId
                    && request.resource.data.createdAt == resource.data.createdAt
                    && request.resource.data.lastEditedByUid == request.auth.uid;
      allow delete: if false;
    }

    // === 재물 마지막 확인 (2026-11-22, 상시 확인 기록) ===
    // 라벨 QR을 찍어 재물을 열거나 조사에서 찍으면 '마지막 확인'을 남긴다. 재물마다 한 건(문서 ID = 재물 ID).
    // 직원도 남겨야 해서 재물(관리자만 씀)과 따로 둔다. 같은 기관 구성원만, 본인 이름·서버 시각으로만 쓴다.
    // 재물이 정말 있는지는 확인하지 않는다(get() 비용) — 문서 ID가 내 기관 접두사라 다른 기관 자리에는 못 쓴다.
    match /assetChecks/{assetId} {
      allow read: if isSuperAdmin() || isOrgMember(resource.data.organizationId);
      allow create, update: if isOrgMember(request.resource.data.organizationId)
                    && assetId.matches(request.resource.data.organizationId + '__.+')
                    && request.resource.data.keys().hasOnly(['organizationId', 'assetId', 'checkedAt', 'checkedByUid',
                                                             'via', 'spaceId', 'surveyId'])
                    && request.resource.data.assetId == assetId
                    && request.resource.data.checkedAt == request.time
                    && request.resource.data.checkedByUid == request.auth.uid
                    && request.resource.data.via in ['qr', 'survey']
                    && nullableString(request.resource.data.spaceId, 100)
                    && nullableString(request.resource.data.surveyId, 100);
      allow delete: if false;
    }

    // === 팀 (2026-11-22) ===
    // 직원 소속 팀과 공간 담당 팀. 경계는 건물과 같다 — 같은 기관이 읽고, 관리자만 쓰며, 지우지 않는다.
    function teamDataValid(d) {
      return d.keys().hasOnly(['organizationId', 'name', 'order', 'archived', 'lastEditedByUid', 'createdAt', 'updatedAt'])
             && d.organizationId is string
             && d.name is string && d.name.size() > 0 && d.name.size() <= 50
             && d.order is int && d.order >= 0
             && d.archived is bool
             && d.updatedAt == request.time;
    }

    match /teams/{teamId} {
      allow read: if isSuperAdmin() || isOrgMember(resource.data.organizationId);
      allow create: if (isSuperAdmin() || isOrgAdmin(request.resource.data.organizationId))
                    && teamDataValid(request.resource.data)
                    && request.resource.data.createdAt == request.time
                    && request.resource.data.lastEditedByUid == request.auth.uid;
      allow update: if (isSuperAdmin() || isOrgAdmin(resource.data.organizationId))
                    && teamDataValid(request.resource.data)
                    && request.resource.data.organizationId == resource.data.organizationId
                    && request.resource.data.createdAt == resource.data.createdAt
                    && request.resource.data.lastEditedByUid == request.auth.uid;
      allow delete: if false;
    }

    // === 건물 (2026-11-22) ===
    // 공간을 묶는 위 단계(건물 → 층 → 공간). 층은 건물 문서의 floors 목록이다.
    // 읽기·쓰기 경계는 공간과 같다 — 같은 기관 구성원이 읽고, 관리자만 쓰며, 지우지 않는다(공간이 가리킨다).
    function buildingDataValid(d) {
      return d.keys().hasOnly(['organizationId', 'name', 'address', 'floors', 'order', 'archived',
                               'lastEditedByUid', 'createdAt', 'updatedAt'])
             && d.organizationId is string
             && d.name is string && d.name.size() > 0 && d.name.size() <= 50
             && d.address is string && d.address.size() <= 200
             && d.floors is list && d.floors.size() <= 50
             && d.order is int && d.order >= 0
             && d.archived is bool
             && d.updatedAt == request.time;
    }

    match /buildings/{buildingId} {
      allow read: if isSuperAdmin() || isOrgMember(resource.data.organizationId);
      allow create: if (isSuperAdmin() || isOrgAdmin(request.resource.data.organizationId))
                    && buildingDataValid(request.resource.data)
                    && request.resource.data.createdAt == request.time
                    && request.resource.data.lastEditedByUid == request.auth.uid;
      allow update: if (isSuperAdmin() || isOrgAdmin(resource.data.organizationId))
                    && buildingDataValid(request.resource.data)
                    && request.resource.data.organizationId == resource.data.organizationId
                    && request.resource.data.createdAt == resource.data.createdAt
                    && request.resource.data.lastEditedByUid == request.auth.uid;
      allow delete: if false;
    }

    // === 재물 (기획서 F04~F08) ===
    // 문서 ID는 `기관ID__자산코드`다(src/lib/import/diff.ts assetDocId). 접두사를 확인해
    // 다른 기관 이름으로 문서를 선점하지 못하게 한다.
    // 읽기는 같은 기관 구성원(4단계 조사에서 직원도 재물 목록을 본다), 쓰기는 기관 관리자.
    // 금액은 이 문서에 없다 — assetAccounting(관리자만). 지우지 않는다(대장에서 빠지면 표시만).
    function nullableString(v, max) {
      return v == null || (v is string && v.size() <= max);
    }
    function nullableNumber(v) {
      return v == null || v is number;
    }
    function assetDataValid(d) {
      return d.keys().hasOnly(['organizationId', 'code', 'name', 'category', 'spec', 'acquiredAt',
                               'acquiredQuantity', 'quantity', 'usefulLife', 'status', 'statusRaw', 'locationRaw',
                               'spaceId', 'department', 'usage', 'missingFromSource', 'manual', 'lastImportId',
                               'tagId', 'photoUrl', 'photoThumbUrl', 'photoPath', 'photoThumbPath',
                               'lastEditedByUid', 'createdAt', 'updatedAt'])
             && d.organizationId is string
             && d.code is string && d.code.size() > 0 && d.code.size() <= 100
             && nullableString(d.name, 200) && nullableString(d.category, 100) && nullableString(d.spec, 200)
             && nullableString(d.acquiredAt, 10)
             && nullableNumber(d.acquiredQuantity) && nullableNumber(d.quantity)
             // 내용연수(햇수, 2026-11-22) — 0~100. 예전 문서에는 없다(src/lib/usefulLife.ts USEFUL_LIFE_MAX)
             && (!('usefulLife' in d) || d.usefulLife == null
                 || (d.usefulLife is number && d.usefulLife >= 0 && d.usefulLife <= 100))
             && d.status in ['active', 'inactive', 'disposed']
             && nullableString(d.statusRaw, 50) && nullableString(d.locationRaw, 200)
             && nullableString(d.spaceId, 100)
             && nullableString(d.department, 100) && nullableString(d.usage, 500)
             && d.missingFromSource is bool
             // 앱에서 직접 등록한 재물 표시(2026-11-22) — 예전 문서에는 없다
             && (!('manual' in d) || d.manual is bool)
             // 대표 사진(2026-11-22) — 주소·경로 글자. 예전 문서에는 없다
             && (!('photoUrl' in d) || nullableString(d.photoUrl, 2000))
             && (!('photoThumbUrl' in d) || nullableString(d.photoThumbUrl, 2000))
             && (!('photoPath' in d) || nullableString(d.photoPath, 500))
             && (!('photoThumbPath' in d) || nullableString(d.photoThumbPath, 500))
             && nullableString(d.lastImportId, 100)
             // QR 태그 ID(기획서 F09) — 헷갈리는 글자(I·L·O·U)를 뺀 대문자·숫자 10자. 없으면 null
             && (d.get('tagId', null) == null || (d.tagId is string && d.tagId.matches('^[0-9A-HJKMNP-TV-Z]{10}$')))
             && d.updatedAt == request.time
             && d.lastEditedByUid == request.auth.uid;
    }

    match /assets/{assetId} {
      allow read: if isSuperAdmin() || isOrgMember(resource.data.organizationId);
      allow create: if (isSuperAdmin() || isOrgAdmin(request.resource.data.organizationId))
                    && assetId.matches(request.resource.data.organizationId + '__.+')
                    && assetDataValid(request.resource.data)
                    && request.resource.data.createdAt == request.time;
      allow update: if (isSuperAdmin() || isOrgAdmin(resource.data.organizationId))
                    && assetDataValid(request.resource.data)
                    && request.resource.data.organizationId == resource.data.organizationId
                    && request.resource.data.code == resource.data.code
                    && request.resource.data.createdAt == resource.data.createdAt
                    // 한 번 발급한 태그는 바꾸거나 지우지 못한다 — 이미 붙인 라벨이 못 쓰게 된다
                    && (resource.data.get('tagId', null) == null
                        || request.resource.data.get('tagId', null) == resource.data.tagId);
      allow delete: if false;
    }

    // 재물 금액 — 관리자만 읽고 쓴다(사용자 결정 2026-11-21). 문서 ID는 재물 문서와 같다.
    match /assetAccounting/{assetId} {
      function accountingValid(d) {
        return d.keys().hasOnly(['organizationId', 'amount', 'depreciation', 'residual', 'lastEditedByUid', 'updatedAt'])
               && d.organizationId is string
               && nullableNumber(d.amount) && nullableNumber(d.depreciation) && nullableNumber(d.residual)
               && d.updatedAt == request.time
               && d.lastEditedByUid == request.auth.uid;
      }
      allow read: if isSuperAdmin() || isOrgAdmin(resource.data.organizationId);
      allow create: if (isSuperAdmin() || isOrgAdmin(request.resource.data.organizationId))
                    && assetId.matches(request.resource.data.organizationId + '__.+')
                    && accountingValid(request.resource.data);
      allow update: if (isSuperAdmin() || isOrgAdmin(resource.data.organizationId))
                    && accountingValid(request.resource.data)
                    && request.resource.data.organizationId == resource.data.organizationId;
      allow delete: if false;
    }

    // 가져오기 기록 — 관리자가 만들고 아무도 고치거나 지우지 않는다
    match /imports/{importId} {
      allow read: if isSuperAdmin() || isOrgAdmin(resource.data.organizationId);
      allow create: if (isSuperAdmin() || isOrgAdmin(request.resource.data.organizationId))
                    && request.resource.data.keys().hasOnly(['organizationId', 'fileName', 'sheetName', 'columnMap',
                                                             'counts', 'diff', 'amountTotal', 'reportedTotal',
                                                             'lastEditedByUid', 'confirmedAt'])
                    && request.resource.data.lastEditedByUid == request.auth.uid
                    && request.resource.data.confirmedAt == request.time;
      allow update, delete: if false;
    }

    // 변경 이력 (기획서 F17) — 생성만. 재물 값의 전·후만 담고 개인정보는 담지 않는다
    match /history/{historyId} {
      allow read: if isSuperAdmin() || isOrgAdmin(resource.data.organizationId);
      allow create: if (isSuperAdmin() || isOrgAdmin(request.resource.data.organizationId))
                    && request.resource.data.keys().hasOnly(['organizationId', 'assetId', 'code', 'type', 'changes',
                                                             'importId', 'lastEditedByUid', 'at'])
                    && request.resource.data.assetId.matches(request.resource.data.organizationId + '__.+')
                    && request.resource.data.type in ['import-change', 'import-missing', 'manual-create', 'manual-edit']
                    && request.resource.data.changes is map
                    && request.resource.data.lastEditedByUid == request.auth.uid
                    && request.resource.data.at == request.time;
      allow update, delete: if false;
    }

    // ── 조사 회차·대상·스캔 (기획서 F10~F12) ──
    // 읽기는 같은 기관 구성원(다른 공간 판정·중복 확인에 필요 — 금액은 없다).
    // 쓰기 경계(사용자 결정 2026-11-21): 스캔은 **내가 담당하는 공간에서만** 남긴다. 관리자는 모든 공간.

    function surveyOf(surveyId) {
      return get(/databases/$(database)/documents/surveys/$(surveyId)).data;
    }
    // 제출·승인된 공간은 스캔이 막힌다(반려되면 다시 열림) — 기획서 F13
    function spaceLocked(surveyId, spaceId) {
      let path = /databases/$(database)/documents/surveySubmissions/$(surveyId + '__' + spaceId);
      return exists(path) && get(path).data.state != 'rejected';
    }
    // 공간 담당자 — 개인으로 지정됐거나, 담당 팀(teamIds)에 속한 직원(2026-11-22).
    // 팀은 찍는 사람의 사용자 문서(teamId)를 읽어 확인한다 — 팀원이 바뀌어도 공간을 고칠 필요가 없다.
    // 개인 지정이 맞으면 사용자 문서를 읽지 않는다(||는 앞이 참이면 뒤를 보지 않는다).
    function isSpaceManager(spaceId, orgId) {
      let space = get(/databases/$(database)/documents/spaces/$(spaceId));
      return space != null
             && space.data.organizationId == orgId
             && (space.data.managerUids.hasAny([request.auth.uid])
                 || (space.data.get('teamIds', []).size() > 0
                     && space.data.get('teamIds', []).hasAny([
                          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('teamId', '')])));
    }

    // 회차 — 관리자가 시작한다. 마감·수정은 5단계에서 연다
    match /surveys/{surveyId} {
      allow read: if isSuperAdmin() || isOrgMember(resource.data.organizationId);
      allow create: if isOrgAdmin(request.resource.data.organizationId)
                    && request.resource.data.keys().hasOnly(['organizationId', 'name', 'startDate', 'endDate', 'spaceIds',
                                                             'includesUnassigned', 'mode', 'status', 'targetCount',
                                                             'lastEditedByUid', 'createdAt'])
                    && request.resource.data.name is string
                    && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 60
                    && request.resource.data.startDate is string && request.resource.data.startDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
                    && request.resource.data.endDate is string && request.resource.data.endDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
                    && request.resource.data.endDate >= request.resource.data.startDate
                    && request.resource.data.spaceIds is list && request.resource.data.spaceIds.size() <= 200
                    && request.resource.data.includesUnassigned is bool
                    && request.resource.data.mode in ['delegated', 'solo']
                    && request.resource.data.status == 'open'
                    && request.resource.data.targetCount is int
                    && request.resource.data.lastEditedByUid == request.auth.uid
                    && request.resource.data.createdAt == request.time;
      // 마감 (기획서 F15) — 열린 회차를 '마감 중'으로 멈춘 뒤 닫는다(2026-11-24). '마감 중'이면 스캔·제출·승인이
      // 모두 막혀(open에서만 허락) 결과가 바뀌지 않는다 — 마감 직전 스캔이나 마감 재시도로 요약·반영 목록이
      // 보고서와 어긋나지 않게. '모든 공간 승인 뒤에만'은 화면이 확인한다
      // (공간 수만큼 문서를 읽어야 해서 Rules로는 확인하지 않는다).
      // 멈추기(open → closing)·마감 취소(closing → open) — 상태만 바꾼다
      allow update: if isOrgAdmin(resource.data.organizationId)
                    && ((resource.data.status == 'open' && request.resource.data.status == 'closing')
                        || (resource.data.status == 'closing' && request.resource.data.status == 'open'))
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'lastEditedByUid'])
                    && request.resource.data.lastEditedByUid == request.auth.uid;
      // 닫기(closing → closed)
      allow update: if isOrgAdmin(resource.data.organizationId)
                    && resource.data.status == 'closing'
                    && request.resource.data.status == 'closed'
                    && request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['status', 'closedAt', 'closedByUid', 'spaceNames', 'spaceLocations', 'summary', 'reportSnapshot', 'lastEditedByUid'])
                    && request.resource.data.closedAt == request.time
                    && request.resource.data.closedByUid == request.auth.uid
                    && request.resource.data.lastEditedByUid == request.auth.uid
                    && request.resource.data.spaceNames is map
                    && (!('spaceLocations' in request.resource.data) || request.resource.data.spaceLocations is map)
                    // 마감 시점 보고서 머리(기관명·결재선·나온 사람 이름, 2026-11-24) — 정해진 모양일 때만
                    && (!('reportSnapshot' in request.resource.data)
                        || (request.resource.data.reportSnapshot is map
                            && request.resource.data.reportSnapshot.keys().hasOnly(['orgName', 'approvalLine', 'personNames'])
                            && request.resource.data.reportSnapshot.orgName is string
                            && request.resource.data.reportSnapshot.orgName.size() <= 100
                            && request.resource.data.reportSnapshot.approvalLine is list
                            && request.resource.data.reportSnapshot.approvalLine.size() <= 10
                            && request.resource.data.reportSnapshot.personNames is map
                            && request.resource.data.reportSnapshot.personNames.size() <= 500))
                    && request.resource.data.summary is map;
      allow delete: if false;
    }

    // 조사 대상 — 회차를 시작할 때 같은 배치로 만들고 바꾸지 않는다
    match /surveyTargets/{targetId} {
      allow read: if isSuperAdmin() || isOrgMember(resource.data.organizationId);
      allow create: if isOrgAdmin(request.resource.data.organizationId)
                    && request.resource.data.keys().hasOnly(['organizationId', 'surveyId', 'spaceId', 'items',
                                                             'lastEditedByUid', 'createdAt'])
                    && targetId.matches(request.resource.data.surveyId + '__.+')
                    && getAfter(/databases/$(database)/documents/surveys/$(request.resource.data.surveyId)).data.organizationId
                       == request.resource.data.organizationId
                    && request.resource.data.items is list && request.resource.data.items.size() <= 3000
                    && request.resource.data.lastEditedByUid == request.auth.uid
                    && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }

    // 스캔 — 문서 ID가 회차+재물이라 같은 물건을 다시 찍으면 '수정'이 되고, 핵심 값 수정은 막혀 수가 늘지 않는다
    match /scans/{scanId} {
      function scanValid(d) {
        return d.keys().hasOnly(['organizationId', 'surveyId', 'assetId', 'code', 'name', 'spaceId', 'expectedSpaceId',
                                 'result', 'method', 'condition', 'memo', 'scannedByUid', 'scannedAt',
                                 'photoUrl', 'photoThumbUrl', 'photoPath', 'photoThumbPath',
                                 'lastEditedByUid', 'updatedAt'])
               && nullableString(d.assetId, 300) && d.code is string && d.code.size() > 0 && d.code.size() <= 300
               && nullableString(d.name, 200)
               && d.spaceId is string && nullableString(d.expectedSpaceId, 100)
               && d.result in ['ok', 'otherSpace', 'unregistered', 'outOfScope']
               && d.method in ['qr', 'manual']
               && d.condition in ['normal', 'damaged', 'labelDamaged']
               && d.memo is string && d.memo.size() <= 200
               // 현장 사진(2026-11-22) — 주소·경로 글자, 예전 문서에는 없다
               && (!('photoUrl' in d) || nullableString(d.photoUrl, 2000))
               && (!('photoThumbUrl' in d) || nullableString(d.photoThumbUrl, 2000))
               && (!('photoPath' in d) || nullableString(d.photoPath, 500))
               && (!('photoThumbPath' in d) || nullableString(d.photoThumbPath, 500))
               && d.updatedAt == request.time
               && d.lastEditedByUid == request.auth.uid;
      }
      // 이 회차에서 이 공간에 스캔을 남길 수 있는가 — 열린 회차, 대상 공간, 관리자 또는 (나눠서 조사일 때) 그 공간 담당자
      function canScanIn(survey, orgId, spaceId) {
        return survey.organizationId == orgId
               && survey.status == 'open'
               && survey.spaceIds.hasAny([spaceId])
               && (isOrgAdmin(orgId) || (survey.mode == 'delegated' && isSpaceManager(spaceId, orgId)));
      }

      // 없는 문서도 '없음'을 확인할 수 있어야 한다 — 다른 공간에서 이미 찍혔는지 미리 확인(peekScan)할 때
      // 없는 문서를 읽으면 resource가 null이라 기관 확인이 거부로 끝난다. ID가 무작위(회차 ID 포함)라
      // 없다는 사실로 알 수 있는 것은 없다.
      allow read: if isSuperAdmin() || (isSignedIn() && resource == null) || isOrgMember(resource.data.organizationId);
      allow create: if isOrgMember(request.resource.data.organizationId)
                    && scanId.matches(request.resource.data.surveyId + '__.+')
                    && canScanIn(surveyOf(request.resource.data.surveyId), request.resource.data.organizationId, request.resource.data.spaceId)
                    && !spaceLocked(request.resource.data.surveyId, request.resource.data.spaceId)
                    && scanValid(request.resource.data)
                    && request.resource.data.scannedByUid == request.auth.uid
                    && request.resource.data.scannedAt == request.time;
      // 나중에 고칠 수 있는 것은 물건 상태·메모와 현장 사진뿐 (기획서 F12, 사진 2026-11-22)
      allow update: if isOrgMember(resource.data.organizationId)
                    && canScanIn(surveyOf(resource.data.surveyId), resource.data.organizationId, resource.data.spaceId)
                    && !spaceLocked(resource.data.surveyId, resource.data.spaceId)
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['condition', 'memo',
                         'photoUrl', 'photoThumbUrl', 'photoPath', 'photoThumbPath', 'updatedAt', 'lastEditedByUid'])
                    && scanValid(request.resource.data);
      // 잘못 찍은 것 지우기 — 열린 회차에서 관리자 또는 찍은 사람 본인
      allow delete: if isOrgMember(resource.data.organizationId)
                    && surveyOf(resource.data.surveyId).status == 'open'
                    && !spaceLocked(resource.data.surveyId, resource.data.spaceId)
                    && (isOrgAdmin(resource.data.organizationId) || resource.data.scannedByUid == request.auth.uid);
    }

    // 공간 제출·승인 (기획서 F13) — '나눠서 조사' 회차만. 문서 ID = 회차__공간
    match /surveySubmissions/{subId} {
      function subValid(d) {
        return d.keys().hasOnly(['organizationId', 'surveyId', 'spaceId', 'state', 'submittedByUid', 'submittedAt',
                                 'reviewedByUid', 'reviewedAt', 'reason', 'selfApproved', 'proxyApproved',
                                 'lastEditedByUid', 'updatedAt'])
               && subId == d.surveyId + '__' + d.spaceId
               && d.state in ['submitted', 'approved', 'rejected']
               && d.reason is string && d.reason.size() <= 200
               && d.selfApproved is bool && d.proxyApproved is bool
               && d.lastEditedByUid == request.auth.uid
               && d.updatedAt == request.time;
      }
      function delegatedOpen(d) {
        let survey = surveyOf(d.surveyId);
        return survey.organizationId == d.organizationId
               && survey.status == 'open'
               && survey.mode == 'delegated'
               && survey.spaceIds.hasAny([d.spaceId]);
      }
      // 제출(처음·다시) — 그 공간 담당자 또는 관리자 본인 이름으로
      function isSubmit(d) {
        return d.state == 'submitted'
               && (isOrgAdmin(d.organizationId) || isSpaceManager(d.spaceId, d.organizationId))
               && d.submittedByUid == request.auth.uid
               && d.submittedAt == request.time
               && d.reviewedByUid == null && d.reviewedAt == null
               && d.reason == '' && d.selfApproved == false && d.proxyApproved == false;
      }

      // 직원 화면은 제출 문서가 생기기 전부터 구독한다 — 없는 문서를 읽으면 resource가 null이라
      // 기관 확인이 거부로 끝나 구독이 끊긴다(제출해도 화면이 잠기지 않던 문제, 2026-11-21 5단계 브라우저 확인에서 발견).
      allow read: if isSuperAdmin() || (isSignedIn() && resource == null) || isOrgMember(resource.data.organizationId);
      allow create: if isOrgMember(request.resource.data.organizationId)
                    && subValid(request.resource.data)
                    && delegatedOpen(request.resource.data)
                    && (isSubmit(request.resource.data)
                        // 대신 승인 — 제출 없이 관리자가 승인, 사유 필수
                        || (isOrgAdmin(request.resource.data.organizationId)
                            && request.resource.data.state == 'approved'
                            && request.resource.data.proxyApproved == true
                            && request.resource.data.selfApproved == false
                            && request.resource.data.submittedByUid == null
                            && request.resource.data.reviewedByUid == request.auth.uid
                            && request.resource.data.reviewedAt == request.time
                            && request.resource.data.reason.size() > 0));
      allow update: if isOrgMember(resource.data.organizationId)
                    && subValid(request.resource.data)
                    && delegatedOpen(request.resource.data)
                    && request.resource.data.organizationId == resource.data.organizationId
                    && request.resource.data.surveyId == resource.data.surveyId
                    && request.resource.data.spaceId == resource.data.spaceId
                    && (
                      // 반려된 공간 다시 제출
                      (resource.data.state == 'rejected' && isSubmit(request.resource.data))
                      // 검토 — 제출된 것만, 관리자가
                      || (isOrgAdmin(resource.data.organizationId)
                          && resource.data.state == 'submitted'
                          && request.resource.data.submittedByUid == resource.data.submittedByUid
                          && request.resource.data.submittedAt == resource.data.submittedAt
                          && request.resource.data.reviewedByUid == request.auth.uid
                          && request.resource.data.reviewedAt == request.time
                          && request.resource.data.proxyApproved == false
                          && (
                            // 반려 — 사유 필수
                            (request.resource.data.state == 'rejected'
                              && request.resource.data.selfApproved == false
                              && request.resource.data.reason.size() > 0)
                            // 승인 — 자기 제출을 승인하면 본인 승인(사유 필수)
                            || (request.resource.data.state == 'approved'
                              && request.resource.data.selfApproved == (resource.data.submittedByUid == request.auth.uid)
                              && (request.resource.data.selfApproved == false || request.resource.data.reason.size() > 0))
                          ))
                    );
      allow delete: if false;
    }

    // 조사 이력 (기획서 F17) — 생성만. 직원은 제출 기록만 남긴다
    match /surveyEvents/{eventId} {
      allow read: if isSuperAdmin() || isOrgAdmin(resource.data.organizationId);
      allow create: if isOrgMember(request.resource.data.organizationId)
                    && request.resource.data.keys().hasOnly(['organizationId', 'surveyId', 'spaceId', 'type', 'reason',
                                                             'targetId', 'byUid', 'at'])
                    && getAfter(/databases/$(database)/documents/surveys/$(request.resource.data.surveyId)).data.organizationId
                       == request.resource.data.organizationId
                    && request.resource.data.type in ['start', 'submit', 'approve', 'reject', 'close', 'sync-done', 'sync-undone']
                    && (request.resource.data.type == 'submit' || isOrgAdmin(request.resource.data.organizationId))
                    && request.resource.data.reason is string && request.resource.data.reason.size() <= 200
                    && request.resource.data.byUid == request.auth.uid
                    && request.resource.data.at == request.time;
      allow update, delete: if false;
    }

    // 희망이음 반영 목록 (기획서 F16) — 마감할 때 관리자가 만들고, 처리 완료만 체크한다
    match /syncTasks/{taskId} {
      function doneValid(d) {
        return d.done is bool
               && ((d.done == true && d.doneByUid == request.auth.uid && d.doneAt == request.time)
                   || (d.done == false && d.doneByUid == null && d.doneAt == null));
      }
      allow read: if isSuperAdmin() || isOrgAdmin(resource.data.organizationId);
      allow create: if isOrgAdmin(request.resource.data.organizationId)
                    && request.resource.data.keys().hasOnly(['organizationId', 'surveyId', 'kind', 'assetId', 'code', 'name',
                                                             'fromSpaceId', 'toSpaceId', 'memo', 'done', 'doneByUid', 'doneAt'])
                    && taskId.matches(request.resource.data.surveyId + '__.+')
                    && surveyOf(request.resource.data.surveyId).organizationId == request.resource.data.organizationId
                    // 마감 중(멈춘 뒤)에만 만든다 — 결과가 더 바뀌지 않을 때 쓴 목록이라야 보고서와 맞는다
                    && surveyOf(request.resource.data.surveyId).status == 'closing'
                    && request.resource.data.kind in ['move', 'dispose', 'missing', 'register', 'relabel']
                    && request.resource.data.done == false
                    && request.resource.data.doneByUid == null && request.resource.data.doneAt == null;
      // 처리 완료 체크만 바꾼다(같은 내용을 다시 쓰는 마감 재시도도 여기로 통과한다)
      allow update: if isOrgAdmin(resource.data.organizationId)
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['done', 'doneByUid', 'doneAt'])
                    && doneValid(request.resource.data);
      allow delete: if false;
    }

    // === 알림 ===
    match /notifications/{notificationId} {
      allow read: if resource.data.targetUid == request.auth.uid || isSuperAdmin();
      // 클라이언트 생성은 superAdmin 전용 (승인/반려 알림 화면). 나머지 알림은 전부
      // Cloud Functions(admin SDK, Rules 우회)가 생성한다.
      // 과거 isSignedIn() 분기는 targetUid 소속 검증이 없어 임의 사용자가 타 기관
      // UID로 알림 텍스트를 주입할 수 있었음 (2026-07-03 감사 발견으로 제거).
      allow create: if isSuperAdmin();
      allow update: if resource.data.targetUid == request.auth.uid
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read', 'updatedAt']);
      allow delete: if resource.data.targetUid == request.auth.uid || isSuperAdmin();
    }

    // === 접속기록/변경 로그 ===
    // Cloud Functions(Admin SDK) 트리거만 기록하며, 클라이언트는 생성·수정·삭제를 전부
    // 할 수 없다. 읽기는 점검 주체에게만 연다 — 개인정보처리자는 각 기관이므로
    // (이용약관 제9조) 기관 관리자가 자기 기관 기록을 점검한다.
    //
    // ⚠️ 이 블록이 막는 것은 **클라이언트의** 위조·변조다. Admin SDK는 Rules를 우회하므로
    // 고시 제16조 ③(위조·변조·도난·분실 방지)을 이것만으로 충족한다고 볼 수 없다. 서버 측
    // 불변성은 별도 수단(불변 버킷·Cloud Logging 싱크 등)이 필요하며 현재 범위 밖이다.
    //
    // organizationId가 '__system__'인 기록(기관 미소속 계정, 주로 superAdmin)은 실재하는
    // 기관 ID가 아니므로 isOrgAdmin이 성립하지 않아 superAdmin만 읽는다.
    match /auditLogs/{logId} {
      allow read: if isSuperAdmin() || isOrgAdmin(resource.data.organizationId);
      allow write: if false;
    }

    // === 전체 공지 발송 이력 ===
    // sendBroadcastNotice(Admin SDK)만 기록한다. 운영자가 "언제 무엇을 몇 명에게
    // 보냈는가"를 화면에서 확인하기 위한 기록이므로 읽기도 superAdmin 한정이다.
    // 본문에 기관·이용자 정보가 담기지 않으나, 발송자 uid가 있어 공개할 이유가 없다.
    match /broadcasts/{broadcastId} {
      allow read: if isSuperAdmin();
      allow write: if false;
    }

    // 앱 오류 기록(2026-11-23) — reportClientError(Admin SDK)만 쓴다. 개인정보를 뺀 오류 요약이고
    // 30일 TTL(expiresAt)로 지워진다. 슈퍼관리자만 읽는다.
    match /clientErrors/{errorId} {
      allow read: if isSuperAdmin();
      allow write: if false;
    }

    // === 피드백 ===
    //
    // create가 `isSignedIn()` 하나였을 때, 로그인한 누구나 이 컬렉션에 문서를 무제한으로
    // 밀어 넣을 수 있었다. 그런데 이 컬렉션의 onCreate는 Discord 웹훅을 실행한다(당시에는
    // 첨부 이미지 다운로드·**Gemini 호출**까지 — AI 초안은 2026-10-16에 없앴다). 즉 클라이언트
    // 쓰기가 곧 서버 비용·운영 채널 도배였다 (2026-08-14 감사 발견 1).
    //
    // 여기서 막는 것은 "한 번의 쓰기가 얼마나 큰 일을 시킬 수 있는가"다(작성자 위조 금지,
    // 첨부 개수·본문 길이 상한). **호출 횟수 자체의 상한은 Rules로 표현할 수 없으므로**
    // 트리거(notifyNewFeedback) 안의 일일 쿼터(GLOBAL_BUDGETS.feedbackAlert*)가 짝을 이룬다. 둘 중 하나만
    // 있으면 반쪽이다.
    match /feedbacks/{feedbackId} {
      allow read: if isSuperAdmin();
      allow create: if isSignedIn()
                    // 타인 명의로 의견을 심을 수 없다 (서버 경로인 submitPublicFeedback은
                    // Admin SDK라 Rules를 우회하므로 'public-inquiry' 표기에 영향 없음).
                    && request.resource.data.authorUid == request.auth.uid
                    // 본문 길이 — submitPublicFeedback의 상한(5000자)과 같은 기준.
                    && request.resource.data.get('message', '') is string
                    && request.resource.data.get('message', '').size() <= 5000
                    && request.resource.data.get('content', '') is string
                    && request.resource.data.get('content', '').size() <= 5000
                    // 첨부는 최대 3개 — 의견 작성 화면의 첨부 상한.
                    && (!request.resource.data.keys().hasAny(['imageUrls'])
                        || (request.resource.data.imageUrls is list
                            && request.resource.data.imageUrls.size() <= 3))
                    // AI(옛 초안)·답변 필드는 서버(superAdmin)만 채운다. 클라이언트가 미리
                    // 심으면 답변 이력이 사용자 입력으로 오염된다.
                    && !request.resource.data.keys().hasAny(['aiDraft', 'aiConfidence', 'reply', 'repliedAt', 'repliedBy']);
      allow update: if isSuperAdmin();
      allow delete: if isSuperAdmin();
    }

    // === 기관 신청 ===
    //
    // 클라이언트 경로가 없다. 접수는 **비인증 콜러블** submitOrgApplication(Admin SDK)이
    // 처리하므로 신청자는 로그인하지 않고, 심사 화면도 이 컬렉션을 읽지 않는다(`src/`
    // 전수 grep에 사용처 없음).
    //
    // 그런데 규칙은 `applicantEmail == request.auth.token.email`로 열려 있었다. 이 조건은
    // 이메일 클레임이 검증됐다는 전제에 기대고, **토큰에 email이 없으면 null == null로
    // 통과**한다 — 익명 로그인 제공자가 켜져 있던 동안 실제로 그런 토큰을 발급할 수 있었다.
    // 쓰지 않는 문을 그 전제 위에 열어 둘 이유가 없다. 2026-08-23 감사 부록 2.
    match /orgApplications/{appId} {
      allow read: if isSuperAdmin();
      allow write: if false; // 접수·심사 모두 Admin SDK 경로다
    }

    // === 시스템 ===
    match /system/{document} {
      allow read: if isSuperAdmin();
      allow write: if false; // Cloud Functions에서만 쓰기
    }

  }
}
